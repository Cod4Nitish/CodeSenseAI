# CodeSense AI — backend environment. by Nitish Singh
# Copy this file to `.env` and fill in the values you need.

# ── Required ────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional extra keys (comma separated) for more capacity and speed. Calls are spread across keys and a slow
# or rate-limited call is raced against the next key.
# GEMINI_API_KEYS=second_key,third_key
# GEMINI_HEDGE_S=7

# ── Security (pin these in any deployed environment) ────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated per-process (tokens won't survive a restart).
# SECRET_KEY=change-me-to-a-long-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# BCRYPT_ROUNDS=12

# ── Persistence ────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./database.db

# ── Demo / guest account (one-click "Try as Guest") ────────
# DEMO_EMAIL=demo@codesense.ai
# DEMO_PASSWORD=DemoPass123!

# ── Optional Gemini overrides (defaults shown) ─────────────
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_S=20   (a slow call is cut at this limit and retried once)

# ── Optional runtime ──────────────────────────────────────
# ENVIRONMENT=development
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_ANALYZE_PER_MINUTE=30
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
